# Copy to .env and fill in for a real deployment. Never commit the real file.

# --- backend ---
DB_URL=jdbc:postgresql://localhost:5432/clubflow
DB_USER=clubflow
DB_PASSWORD=change-me
JWT_SECRET=generate-with-openssl-rand-base64-48
FRONTEND_URL=https://your-frontend.example.com
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
APP_TIMEZONE=Asia/Kolkata

SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=you@example.com
SUPERADMIN_PASSWORD=choose-a-long-passphrase
SEED_DEMO_DATA=false

# Email (SMTP). For Resend use host smtp.resend.com, port 465/587, user "resend", password = API key.
MAIL_ENABLED=true
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USER=resend
MAIL_PASSWORD=re_xxxxxxxx
MAIL_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=ClubFlow <no-reply@your-domain.example>

# --- frontend (build time) ---
VITE_API_URL=https://your-api.example.com
